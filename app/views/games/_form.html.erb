
<% if game.errors.any? %>
  <div>
    <h2>入力エラー</h2>
    <ul>
      <% game.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: game do |form| %>
  <div>
    <%= form.label :title, "タイトル" %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :genre, "ジャンル" %>
    <%= form.text_field :genre %>
  </div>

  <div>
    <%= form.label :rating, "評価" %>
    <%= form.number_field :rating %>
  </div>

  <div>
    <%= form.submit game.new_record? ? "登録" : "更新" %>
  </div>
<% end %>
